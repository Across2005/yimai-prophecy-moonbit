import {
  "moonbitlang/core/json",
  "moonbitlang/core/ref",
  "moonbitlang/core/strconv",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env" @env,
  "moonbitlang/async",
  "moonbitlang/async/http" @http,
  "moonbitlang/async/socket" @socket,
  "moonbitlang/async/fs" @fs,
  "moonbitlang/async/io" @io,
  "Across2005/yimai_prophecy_moonbit" @lib,
}

// async 的 socket/http server 仅支持 native target（非 native 为桩）
supported_targets = "+native"

options(
  "is-main": true,
  link: {
    "native": {
      // MSVC 探测：依赖 PATH 里的 cl.exe。
      //   1. Developer Command Prompt (vcvars64.bat 已加载) → 直接 build
      //   2. 其它终端：先跑一次 vcvars64.bat 再 build
      //   3. 装在非标准路径：set MSVC_CC 环境变量覆盖，例如：
      //        $env:MSVC_CC = "C:/Program Files (x86)/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.34.31933/bin/Hostx64/x64/cl.exe"
      //   4. setup.ps1 会探测 $env:MSVC_CC 或 PATH 并给出明确提示
      "cc": "cl.exe"
    },
  },
)
